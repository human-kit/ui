{
	"name": "@agustin/monorepo",
	"private": true,
	"type": "module",
	"workspaces": [
		"packages/*",
		"docs"
	],
	"scripts": {
		"dev": "bun --filter docs dev",
		"build": "bun --filter @human-kit/svelte-components package",
		"build:docs": "bun --filter docs build",
		"test": "bun --filter @human-kit/svelte-components test",
		"typecheck": "bun --filter @human-kit/svelte-components check && bun --filter docs check",
		"check": "bun run --filter '*' check",
		"format": "prettier --write .",
		"lint:md": "npx markdownlint-cli2",
		"lint:md:fix": "npx markdownlint-cli2 --fix",
		"lint": "prettier --check . && eslint .",
		"changeset:auto:draft": "node scripts/changeset-auto.mjs --draft --only-if-missing",
		"changeset:auto:apply": "node scripts/changeset-auto.mjs --apply --only-if-missing",
		"release": "bun run build && bunx changeset publish",
		"pr": "bash scripts/pr.sh"
	},
	"devDependencies": {
		"@changesets/changelog-github": "^0.5.2",
		"@changesets/cli": "^2.29.8",
		"@eslint/compat": "^1.4.0",
		"@eslint/js": "^9.38.0",
		"eslint": "^9.38.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.12.4",
		"globals": "^16.4.0",
		"prettier": "^3.6.2",
		"prettier-plugin-svelte": "^3.4.0",
		"prettier-plugin-tailwindcss": "^0.7.1",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.46.1"
	}
}
