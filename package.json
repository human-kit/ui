{
	"name": "@human-kit/monorepo",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@11.5.2",
	"engines": {
		"node": ">=20",
		"pnpm": ">=9"
	},
	"scripts": {
		"dev": "pnpm --filter docs dev",
		"build": "pnpm --filter @human-kit/ui run package",
		"build:docs": "pnpm --filter docs build",
		"test": "pnpm --filter @human-kit/ui test",
		"typecheck": "pnpm --filter @human-kit/ui check && pnpm --filter docs check",
		"check": "pnpm -r run check",
		"format": "prettier --write .",
		"lint:md": "pnpm dlx markdownlint-cli2",
		"lint:md:fix": "pnpm dlx markdownlint-cli2 --fix",
		"todo:check": "node scripts/check-todo-format.mjs",
		"lint": "prettier --check . && eslint . && pnpm run todo:check",
		"changeset:auto:draft": "node scripts/changeset-auto.mjs --draft --only-if-missing",
		"changeset:auto:apply": "node scripts/changeset-auto.mjs --apply --only-if-missing",
		"release": "pnpm run build && node scripts/publish.mjs",
		"pr": "bash scripts/pr.sh"
	},
	"devDependencies": {
		"@changesets/changelog-github": "^0.5.2",
		"@changesets/cli": "^2.29.8",
		"@eslint/compat": "^1.4.0",
		"@eslint/js": "^9.38.0",
		"eslint": "^9.38.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.12.4",
		"globals": "^16.4.0",
		"prettier": "^3.6.2",
		"prettier-plugin-svelte": "^3.4.0",
		"prettier-plugin-tailwindcss": "^0.7.1",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.46.1"
	},
	"dependencies": {
		"tailwind-variants": "^3.2.2"
	}
}
